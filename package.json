{
  "name": "trinkwasser-erinnerung",
  "productName": "Trinkwasser",
  "version": "0.2.0",
  "description": "Erinnert im Windows-Tray ans Wassertrinken",
  "main": "src/main/main.js",
  "author": "J. B. Dietrich",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/gen-icons.js",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.jbdietrich.trinkwasser",
    "productName": "Trinkwasser",
    "copyright": "© 2026 J. B. Dietrich",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "protocols": [
      {
        "name": "Trinkwasser",
        "schemes": [
          "trinkwasser"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "appx",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Trinkwasser-${version}-portable.${ext}"
    },
    "appx": {
      "identityName": "PLATZHALTER.Trinkwasser",
      "publisher": "CN=PLATZHALTER",
      "publisherDisplayName": "J. B. Dietrich",
      "applicationId": "Trinkwasser",
      "displayName": "Trinkwasser",
      "backgroundColor": "transparent",
      "languages": [
        "de-DE",
        "en-US"
      ],
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0",
      "addAutoLaunchExtension": false,
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "Trinkwasser-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Trinkwasser",
      "artifactName": "Trinkwasser-Setup-${version}.${ext}"
    }
  }
}
